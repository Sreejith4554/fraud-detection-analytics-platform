# Export DATABASE_URL in the shell; this application does not auto-load .env.
# Template only. Create a local database and choose its credentials yourself.
DATABASE_URL=postgresql+psycopg://fraud_user:CHANGE_ME@127.0.0.1:5432/fraud_demo
# Integration tests truncate only a separately provisioned *_test database.
FRAUD_TEST_DATABASE_URL=postgresql+psycopg://fraud_user:CHANGE_ME@127.0.0.1:5432/fraud_test
# Dashboard only; it has no database credentials or model artifact dependency.
API_BASE_URL=http://127.0.0.1:8000
